# DATABASE_MODE selects both the SQL dialect and the driver used to connect.
# One of: RUNTIME_SQLITE | NODE_SQLITE | BETTER_SQLITE3 | LIBSQL | BUN_SQL | CLOUDFLARE
#       | NODE_POSTGRES | POSTGRES_JS | NEON
# Defaults to RUNTIME_SQLITE, which picks NODE_SQLITE or BUN_SQL based on whether the
# process is actually started with `node` or `bun` - use an explicit mode to pin one driver.
DATABASE_MODE="RUNTIME_SQLITE"

# Connection string / file path, meaning depends on DATABASE_MODE:
# - RUNTIME_SQLITE / NODE_SQLITE / BETTER_SQLITE3 / BUN_SQL: path to a local sqlite file (defaults to risuainext.db)
# - LIBSQL: libsql:// or file: URL
# - NODE_POSTGRES / POSTGRES_JS / NEON: postgres:// connection string
# - CLOUDFLARE: unused, see the Cloudflare D1 vars below instead
DATABASE_URL=""

# Cloudflare (CLOUDFLARE_ACCOUNT_ID/DATABASE_ID only used when DATABASE_MODE=CLOUDFLARE;
# CLOUDFLARE_API_TOKEN is a general Cloudflare API token, also used by other integrations)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_API_TOKEN=""
